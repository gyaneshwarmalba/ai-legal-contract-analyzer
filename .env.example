# Everything defaults to offline mode. Switch individual components to cloud services here.
LLM_PROVIDER=local            # local | bedrock
EMBEDDINGS_PROVIDER=local     # local | bedrock
VECTOR_STORE=memory           # memory | faiss
RESULT_SINK=local             # local | salesforce
SEED_SAMPLE_DATA=true
TOP_K=4
MIN_RELEVANCE=0.08
LOG_LEVEL=INFO

# AWS Bedrock (uses the standard AWS credential chain; prefer SSO/IAM roles over static keys)
AWS_DEFAULT_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Salesforce (RESULT_SINK=salesforce)
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_DOMAIN=login
SF_RESULT_OBJECT=Contract_Analysis__c
